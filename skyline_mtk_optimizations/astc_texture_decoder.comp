#version 450

/*
 * MediaTek BCn to Uncompressed/ASTC Texture Decoder (Compute Shader)
 *
 * Processadores MediaTek (Mali GPUs) normalmente NÃO possuem suporte a 
 * compressão de texturas do tipo BC1/BC2/BC3 (Dxt1/3/5) comuns no PC/Switch.
 * Isso causa texturas corrompidas ou pretas nos emuladores.
 *
 * Em vez de sobrecarregar a CPU fazendo essa decodificação via software,
 * injetamos este Compute Shader na pipeline do emulador para decodificar 
 * as texturas na GPU MediaTek em tempo real!
 */

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout (binding = 0) uniform sampler2D u_InputBCnTexture;
layout (binding = 1, rgba8) writeonly uniform image2D u_OutputTexture;

// Função simplificada de extração de blocos DXT (4x4 pixels)
// Uma implementação completa exige interpolação das tabelas de cores de 16-bits.
vec4 DecodeBC1Block(vec2 uv) {
    // 1. Ler o bloco de 64-bits da textura comprimida
    vec4 rawData = texture(u_InputBCnTexture, uv);
    
    // (Pseudocódigo)
    // 2. Extrair Color0 e Color1 (RGB565)
    // 3. Gerar Color2 e Color3 (Interpolação 1/3 e 2/3)
    // 4. Ler o índice de 2-bits para o pixel específico
    // 5. Retornar a cor RGB(A)
    
    // Fallback ilustrativo para decodificação:
    return rawData; 
}

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 texSize = imageSize(u_OutputTexture);

    if (pixelCoord.x >= texSize.x || pixelCoord.y >= texSize.y) {
        return;
    }

    // Calcula coordenadas UV
    vec2 uv = vec2(pixelCoord) / vec2(texSize);

    // Na arquitetura MediaTek, delegamos o trabalho pesado de decodificação de blocos
    // para as ALUs paralelas da Mali, usando Compute.
    vec4 decodedColor = DecodeBC1Block(uv);

    // Grava a textura em formato RGBA8 bruto na VRAM da Mali
    // A Mali agora pode usar essa textura perfeitamente, sem precisar de suporte nativo a BCn.
    imageStore(u_OutputTexture, pixelCoord, decodedColor);
}
